# Eigenes, langes Passwort fuer die Datenbank (nur intern im Docker-Netz verwendet).
DB_PASSWORD=

# Zeitzone des Servers
TZ=Europe/Berlin

# Wie RedDrop nach aussen kommt (install.sh setzt das automatisch):
#   eigener Caddy auf Port 80/443 mit automatischem HTTPS:
COMPOSE_FILE=docker-compose.yml:compose.caddy.yml
#   ODER nur ein Port hinter deinem vorhandenen nginx/Apache:
#COMPOSE_FILE=docker-compose.yml:compose.port.yml
#RD_PORT=8080
#RD_BIND=127.0.0.1
#RD_PROXY_DOMAIN=drop.deinefirma.de

# --- Pro (nur mit Lizenz, sonst ohne Wirkung) ---
# Name dieses Servers in der Server-Liste:
#RD_NODE_NAME=server-1
# S3 fest vorgeben (sonst im Panel unter „Speicher & Server“ einstellen):
#RD_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#RD_S3_REGION=auto
#RD_S3_BUCKET=reddrop
#RD_S3_ACCESS_KEY=
#RD_S3_SECRET_KEY=
#RD_S3_PATH_STYLE=false
#RD_S3_PREFIX=

# Virenscan mit ClamAV (eigener Container, ~1,5 GB RAM). Auch im Panel umschaltbar.
# COMPOSE_PROFILES=virenscan

# Cloudflare Tunnel — setzt das Panel (Einstellungen → Installation) automatisch, nicht von Hand nötig.
# RD_TUNNEL_TOKEN=
